          </tr>
          <tr><td class="px-3 py-2">Dex</td><td class="px-3 py-2">Limited</td><td class="px-3 py-2">No</td><td class="px-3 py-2">No</td><td class="px-3 py-2">No</td><td class="px-3 py-2">Networking / pro contacts</td></tr>
          <tr><td class="px-3 py-2">Garden</td><td class="px-3 py-2">Yes</td><td class="px-3 py-2">No</td><td class="px-3 py-2">No</td><td class="px-3 py-2">No</td><td class="px-3 py-2">Light reminder use</td></tr>
          <tr><td class="px-3 py-2">Catchup</td><td class="px-3 py-2">Yes</td><td class="px-3 py-2">No</td><td class="px-3 py-2">No</td><td class="px-3 py-2">No</td><td class="px-3 py-2">Bare-minimum reminders</td></tr>
          <tr><td class="px-3 py-2">Amicu</td><td class="px-3 py-2">Limited</td><td class="px-3 py-2">No</td><td class="px-3 py-2">Limited</td><td class="px-3 py-2">No</td><td class="px-3 py-2">All-purpose CRM</td></tr>
