---
import AppStoreBadge from './AppStoreBadge.astro';
import PhoneMockup from './PhoneMockup.astro';
---

<section id="hero" class="relative min-h-[100svh] flex items-center overflow-hidden" data-bg="#0a0a12">
  <!-- Hero background gradient -->
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at 50% 30%, rgba(0, 212, 255, 0.06) 0%, transparent 60%);"></div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 pt-12 sm:pt-20 pb-16 sm:pb-24 w-full" style="z-index: 2;">
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
      <!-- Text content -->
      <div class="flex-1 text-center lg:text-left">
        <!-- HUD status line -->
        <div class="hero-status flex items-center gap-2 mb-6 justify-center lg:justify-start">
          <span class="w-2 h-2 rounded-full bg-cyan animate-glow-pulse"></span>
          <span class="text-xs font-mono text-cyan/60 tracking-widest uppercase">System Online</span>
        </div>

        <h1
          class="glitch-text text-4xl sm:text-5xl lg:text-7xl font-bold text-foreground leading-[1.05] tracking-tight mb-5"
          data-text="Stay close to the people who matter"
        >
          Stay close to the people who matter
        </h1>

        <p class="text-lg sm:text-xl text-foreground/50 leading-relaxed max-w-lg mx-auto lg:mx-0 mb-4">
          Connection tracking, an AI coach that knows your relationships, and smart suggestions right inside iMessage.
        </p>

        <p class="text-sm text-foreground/30 mb-8 font-mono">
          // Built for the friends you keep meaning to text back.
        </p>

        <div class="flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start">
          <AppStoreBadge />
        </div>

        <p class="mt-5 text-xs text-foreground/20 font-mono">
          Free on the App Store. No credit card required.
        </p>
      </div>

      <!-- Phone mockup with holographic glow -->
      <div class="flex-shrink-0 relative hero-phone">
        <!-- Glow behind phone -->
        <div class="absolute inset-0 -m-8 rounded-full blur-3xl opacity-30" style="background: radial-gradient(circle, rgba(0, 212, 255, 0.3), transparent 70%);"></div>
        <div class="relative">
          <PhoneMockup />
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-6 left-1/2" style="animation: chevron-bounce 2s ease-in-out infinite;">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-cyan/40"><path d="m6 9 6 6 6-6"/></svg>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  // Hero entrance animation sequence
  const tl = gsap.timeline({ delay: 0.3 });

  tl.from('.hero-status', { opacity: 0, x: -20, duration: 0.5, ease: 'power2.out' })
    .from('.glitch-text', { opacity: 0, y: 40, duration: 0.8, ease: 'power3.out' }, '-=0.2')
    .from('.glitch-text + p', { opacity: 0, y: 20, duration: 0.6, ease: 'power2.out' }, '-=0.4')
    .from('.glitch-text ~ p:nth-of-type(2)', { opacity: 0, duration: 0.4 }, '-=0.2')
    .from('.hero-phone', { opacity: 0, scale: 0.9, y: 30, duration: 1, ease: 'power3.out' }, '-=0.6');
</script>
