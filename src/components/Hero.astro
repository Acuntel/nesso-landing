---
import AppStoreBadge from './AppStoreBadge.astro';
import PhoneMockup from './PhoneMockup.astro';
---

<section class="relative overflow-hidden animated-bg">
  <!-- Ambient blobs -->
  <div class="ambient-blob w-72 h-72 top-10 -left-20 opacity-60" style="animation-duration: 20s;"></div>
  <div class="ambient-blob w-96 h-96 -top-20 right-0 opacity-40" style="animation-duration: 28s;"></div>
  <div class="ambient-blob w-64 h-64 bottom-10 left-1/3 opacity-50" style="animation-duration: 24s;"></div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 pt-12 sm:pt-20 pb-16 sm:pb-24">
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
      <!-- Text content -->
      <div class="flex-1 text-center lg:text-left">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-foreground leading-[1.1] tracking-tight mb-5">
          Stay close to the people who matter
        </h1>
        <p class="text-lg sm:text-xl text-muted-foreground leading-relaxed max-w-lg mx-auto lg:mx-0 mb-4">
          Gentle reminders, connection tracking, and AI-powered messages that help you nurture your most important relationships.
        </p>
        <p class="text-sm text-muted-foreground/70 mb-8 italic">
          Built for the friends you keep meaning to text back.
        </p>
        <div class="flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start">
          <AppStoreBadge />
        </div>
      </div>

      <!-- Phone mockup -->
      <div class="flex-shrink-0">
        <PhoneMockup />
      </div>
    </div>
  </div>
</section>
