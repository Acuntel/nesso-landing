---

<section id="features" class="py-20 sm:py-32 px-4 sm:px-6 scroll-mt-20 relative" data-bg="#0a0e1a">
  <div class="max-w-4xl mx-auto relative" style="z-index: 2;">
    <div class="text-center mb-14 reveal">
      <div class="hud-bracket inline-block mb-4">
        <span class="text-xs font-mono text-cyan/50 tracking-[0.3em] uppercase">Arsenal</span>
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-foreground mb-3">Everything you need to stay close</h2>
      <p class="text-foreground/40">Simple tools that make maintaining relationships effortless.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 feature-grid" style="perspective: 1000px;">
      {features.map((feature, i) => (
        <div
          class="feature-card glass-card rounded-2xl p-6 hover-lift card-glow holo-border relative overflow-hidden reveal"
          style={`transition-delay: ${i * 0.08}s;`}
          data-glow={feature.glowColor}
        >
          {/* Scan line */}
          <div class="absolute inset-0 pointer-events-none scan-line opacity-30"></div>

          {/* New badge */}
          {feature.badge && (
            <span class="absolute top-4 right-4 flex items-center gap-1.5 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded-full bg-cyan/10 text-cyan border border-cyan/20">
              <span class="w-1.5 h-1.5 rounded-full bg-cyan animate-glow-pulse"></span>
              {feature.badge}
            </span>
          )}

          {/* Icon with colored glow */}
          <div class="relative mb-4">
            <div class="absolute inset-0 -m-2 rounded-full blur-xl" style={`background: ${feature.glowColor};`}></div>
            <div class:list={['relative', feature.iconColor]}>
              <Fragment set:html={feature.icon} />
            </div>
          </div>

          {/* Text */}
          <h3 class="text-lg font-semibold text-foreground mb-2 relative">{feature.title}</h3>
          <p class="text-sm text-foreground/40 leading-relaxed relative">{feature.description}</p>
        </div>
      ))}
    </div>

    <!-- Mini CTA -->
    <div class="text-center mt-10 reveal">
      <a
        href="https://apps.apple.com/us/app/nesso-ai/id6759138532"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-semibold transition-all duration-200 border border-cyan/30 text-cyan hover:bg-cyan/10 hover:border-cyan/60 hover:shadow-[0_0_20px_rgba(0,212,255,0.15)]"
      >
        Try it free
      </a>
      <p class="text-xs text-foreground/20 mt-3 font-mono">Free to download. No credit card required.</p>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // 3D fly-in for feature cards
  const cards = document.querySelectorAll('.feature-card');
  const directions = [
    { x: -60, rotateY: 15 },
    { x: 0, rotateY: 0, y: 60 },
    { x: 60, rotateY: -15 },
    { x: -60, rotateY: 10 },
    { x: 0, rotateY: 0, y: 60 },
    { x: 60, rotateY: -10 },
  ];

  cards.forEach((card, i) => {
    const dir = directions[i] || { x: 0, y: 40 };
    gsap.from(card, {
      x: dir.x || 0,
      y: dir.y || 40,
      rotateY: dir.rotateY || 0,
      opacity: 0,
      duration: 0.8,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: card,
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
    });
  });

  // 3D tilt on mouse move (desktop only)
  if (window.innerWidth >= 768) {
    cards.forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = (card as HTMLElement).getBoundingClientRect();
        const x = (e as MouseEvent).clientX - rect.left;
        const y = (e as MouseEvent).clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = ((y - centerY) / centerY) * -8;
        const rotateY = ((x - centerX) / centerX) * 8;

        gsap.to(card, {
          rotateX,
          rotateY,
          duration: 0.3,
          ease: 'power2.out',
          transformPerspective: 800,
        });
      });

      card.addEventListener('mouseleave', () => {
        gsap.to(card, {
          rotateX: 0,
          rotateY: 0,
          duration: 0.5,
          ease: 'power2.out',
        });
      });
    });
  }
</script>
