---
import AppStoreBadge from './AppStoreBadge.astro';
---

<section class="py-28 sm:py-40 px-4 sm:px-6 relative overflow-hidden" data-bg="#060610">
  <!-- Convergence glow -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full blur-3xl opacity-20" style="background: radial-gradient(circle, rgba(0, 212, 255, 0.4), rgba(233, 30, 140, 0.1), transparent 70%);"></div>
  </div>

  <!-- Animated ring -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] sm:w-[500px] sm:h-[500px] pointer-events-none">
    <div class="absolute inset-0 rounded-full border border-cyan/10 animate-glow-pulse" style="animation-duration: 3s;"></div>
    <div class="absolute inset-4 rounded-full border border-cyan/5 animate-glow-pulse" style="animation-duration: 4s; animation-delay: 0.5s;"></div>
    <div class="absolute inset-8 rounded-full border border-cyan/[0.03] animate-glow-pulse" style="animation-duration: 5s; animation-delay: 1s;"></div>
  </div>

  <div class="relative text-center max-w-2xl mx-auto reveal" style="z-index: 2;">
    <div class="hud-bracket inline-block mb-6">
      <span class="text-xs font-mono text-cyan/50 tracking-[0.3em] uppercase">Mission Ready</span>
    </div>

    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground leading-snug mb-5">
      Your relationships deserve more than good intentions.
    </h2>

    <p class="text-foreground/40 mb-10 text-lg sm:text-xl">
      Stop meaning to reach out. Start actually doing it.
    </p>

    <div class="flex justify-center">
      <a
        href="https://apps.apple.com/us/app/nesso-ai/id6759138532"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-3 px-8 py-4 rounded-full text-base font-bold transition-all duration-300 relative overflow-hidden"
        style="background: linear-gradient(135deg, rgba(0, 212, 255, 0.15), rgba(233, 30, 140, 0.1)); border: 1px solid rgba(0, 212, 255, 0.3);"
      >
        <!-- Glow on hover -->
        <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300" style="background: linear-gradient(135deg, rgba(0, 212, 255, 0.25), rgba(233, 30, 140, 0.15)); box-shadow: 0 0 40px rgba(0, 212, 255, 0.2);"></div>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="relative text-cyan"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
        <span class="relative text-foreground">Download Nesso</span>
      </a>
    </div>

    <p class="mt-6 text-xs text-foreground/20 font-mono">
      Free to download. Your connections are worth it.
    </p>

    <div class="mt-10">
      <a href="#hero" class="text-sm text-foreground/20 hover:text-cyan/60 transition-colors font-mono">
        // back_to_top
      </a>
    </div>
  </div>
</section>
