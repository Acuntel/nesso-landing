---
import AppStoreBadge from './AppStoreBadge.astro';
---

<section class="py-20 sm:py-28 px-4 sm:px-6 relative overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 animated-bg opacity-50"></div>
  <div class="ambient-blob w-80 h-80 -top-20 -left-20 opacity-40" style="animation-duration: 22s;"></div>
  <div class="ambient-blob w-64 h-64 -bottom-10 -right-10 opacity-30" style="animation-duration: 26s;"></div>

  <div class="relative text-center max-w-xl mx-auto reveal">
    <h2 class="text-2xl sm:text-4xl font-bold text-foreground leading-snug mb-4">
      Your relationships deserve more than good intentions.
    </h2>
    <p class="text-muted-foreground mb-8 text-base sm:text-lg">
      Stop meaning to reach out. Start actually doing it.
    </p>
    <div class="flex justify-center">
      <AppStoreBadge />
    </div>
    <p class="text-xs text-muted-foreground/50 mt-6">
      Free to download. Your connections are worth it.
    </p>
  </div>
</section>
