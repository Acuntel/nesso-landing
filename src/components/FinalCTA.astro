---
import AppStoreBadge from './AppStoreBadge.astro';
---

<section class="py-24 sm:py-32 px-4 sm:px-6 relative overflow-hidden">
  <!-- Strong gradient background -->
  <div class="absolute inset-0 animated-bg"></div>

  <div class="relative text-center max-w-2xl mx-auto reveal">
    <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-semibold text-foreground leading-[1.05] tracking-[-0.03em] mb-5">
      Your relationships deserve more than good intentions.
    </h2>
    <p class="text-muted-foreground mb-10 text-lg sm:text-xl">
      Stop meaning to reach out. Start actually doing it.
    </p>
    <div class="flex justify-center">
      <AppStoreBadge />
    </div>
    <p class="mt-6 text-xs text-muted-foreground/50">
      Free to download. Your connections are worth it.
    </p>
    <div class="mt-8">
      <a href="#" class="text-sm text-muted-foreground/50 hover:text-muted-foreground transition-colors">
        Back to top
      </a>
    </div>
  </div>
</section>
