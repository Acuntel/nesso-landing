---
const appStoreUrl = 'https://apps.apple.com/us/app/nesso-ai/id6759138532';

const stats = [
  {
    number: '200',
    prefix: '~',
    suffix: '',
    label: 'visits remaining with a parent in their 70s, if you see them 10 times a year',
  },
  {
    number: '52',
    prefix: '',
    suffix: 'x',
    label: 'more moments per year, just from one extra text or call each week',
  },
  {
    number: '50',
    prefix: '',
    suffix: '%',
    label: 'longer life expectancy linked to close relationships, more than diet or exercise',
  },
];
---

<section class="py-20 sm:py-32 px-4 sm:px-6 relative" data-bg="#0a0e18">
  <div class="max-w-3xl mx-auto relative" style="z-index: 2;">
    <!-- Emotional hook -->
    <div class="text-center mb-14 reveal">
      <div class="hud-bracket inline-block mb-6">
        <span class="text-xs font-mono text-cyan/50 tracking-[0.3em] uppercase">Incoming Signal</span>
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-foreground leading-snug mb-4">
        You meant to text them back.<br />
        <span class="text-cyan/80">It's been 3 weeks.</span>
      </h2>
      <p class="text-base sm:text-lg text-foreground/40 leading-relaxed max-w-xl mx-auto">
        The group chat went quiet. Nobody noticed until it was too late.
        Life gets busy, but your relationships shouldn't pay the price.
      </p>
    </div>

    <!-- Stat cards -->
    <div class="space-y-3 mb-10">
      {stats.map((s, i) => (
        <div
          class="glass-card rounded-2xl px-5 py-4 flex items-start gap-4 hover-lift holo-border reveal"
          style={`transition-delay: ${i * 0.1}s;`}
        >
          <span class="text-2xl font-bold text-cyan shrink-0 min-w-[60px] font-mono">
            {s.prefix}<span class="counter" data-target={s.number}>0</span>{s.suffix}
          </span>
          <p class="text-sm text-foreground/50 leading-relaxed pt-0.5">{s.label}</p>
        </div>
      ))}
    </div>

    <!-- Research callout — classified document feel -->
    <div class="rounded-2xl p-5 border border-cyan/10 bg-cyan/[0.02] relative overflow-hidden scan-line reveal">
      <p class="text-[11px] text-cyan/60 font-mono uppercase tracking-[0.3em] mb-2">
        // Harvard Research — 85 Year Study
      </p>
      <p class="text-sm text-foreground/60 leading-relaxed">
        After 85 years and thousands of participants, Harvard's longest-running study on human happiness found that
        <span class="font-semibold text-foreground/90">close relationships are the single greatest predictor of a long, healthy life</span>
        , more than wealth, fame, or genetics.
      </p>
    </div>

    <!-- Mini CTA -->
    <div class="text-center mt-10 reveal">
      <a
        href={appStoreUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-semibold transition-all duration-200 border border-cyan/30 text-cyan hover:bg-cyan/10 hover:border-cyan/60 hover:shadow-[0_0_20px_rgba(0,212,255,0.15)]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
        Start staying close
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Scroll-scrubbed counter animation
  document.querySelectorAll('.counter').forEach((el) => {
    const target = parseInt((el as HTMLElement).dataset.target || '0', 10);

    ScrollTrigger.create({
      trigger: el.closest('.glass-card') || el,
      start: 'top 80%',
      onEnter: () => {
        gsap.to({ val: 0 }, {
          val: target,
          duration: 1.5,
          ease: 'power2.out',
          onUpdate: function() {
            (el as HTMLElement).textContent = Math.floor(this.targets()[0].val).toString();
          },
        });
      },
      once: true,
    });
  });
</script>
