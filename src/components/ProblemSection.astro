---
const appStoreUrl = 'https://apps.apple.com/us/app/nesso-ai/id6759138532';

const stats = [
  {
    number: '200',
    prefix: '~',
    suffix: '',
    label: 'visits remaining with a parent in their 70s, if you see them 10 times a year',
  },
  {
    number: '52',
    prefix: '',
    suffix: 'x',
    label: 'more moments per year, just from one extra text or call each week',
  },
  {
    number: '50',
    prefix: '',
    suffix: '%',
    label: 'longer life expectancy linked to close relationships, more than diet or exercise',
  },
];
---

<section class="py-16 sm:py-24 px-4 sm:px-6">
  <div class="max-w-3xl mx-auto">
    <!-- Emotional hook -->
    <div class="text-center mb-14 reveal">
      <h2 class="text-2xl sm:text-3xl font-bold text-foreground leading-snug mb-4">
        You meant to text them back.<br />It's been 3 weeks.
      </h2>
      <p class="text-base sm:text-lg text-muted-foreground leading-relaxed max-w-xl mx-auto">
        The group chat went quiet. Nobody noticed until it was too late.
        Life gets busy, but your relationships shouldn't pay the price.
      </p>
    </div>

    <!-- Stat cards with counter animation -->
    <div class="space-y-3 mb-10 reveal" style="transition-delay: 0.1s;">
      {stats.map((s) => (
        <div class="glass-card rounded-2xl px-5 py-4 flex items-start gap-4 hover-lift">
          <span class="text-2xl font-bold text-foreground shrink-0 min-w-[60px]">
            {s.prefix}<span class="counter" data-target={s.number}>0</span>{s.suffix}
          </span>
          <p class="text-sm text-muted-foreground leading-relaxed pt-0.5">{s.label}</p>
        </div>
      ))}
    </div>

    <!-- Research callout -->
    <div class="rounded-2xl p-5 border border-rose/15 bg-rose/5 reveal" style="transition-delay: 0.2s;">
      <p class="text-[13px] text-muted-foreground font-medium uppercase tracking-widest mb-2">
        Research
      </p>
      <p class="text-sm text-foreground/75 leading-relaxed">
        After 85 years and thousands of participants, Harvard's longest-running study on human happiness found that
        <span class="font-semibold text-foreground">close relationships are the single greatest predictor of a long, healthy life</span>
        , more than wealth, fame, or genetics.
      </p>
    </div>

    <!-- Mini CTA -->
    <div class="text-center mt-10 reveal" style="transition-delay: 0.3s;">
      <a
        href={appStoreUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-foreground text-background text-sm font-semibold hover:opacity-90 transition-opacity"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
        Start staying close
      </a>
    </div>
  </div>
</section>

<script>
  // Counter animation on scroll
  const counters = document.querySelectorAll('.counter');
  const counterObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const target = parseInt(el.dataset.target || '0', 10);
          let current = 0;
          const duration = 1500;
          const step = target / (duration / 16);
          const animate = () => {
            current += step;
            if (current >= target) {
              el.textContent = target.toString();
            } else {
              el.textContent = Math.floor(current).toString();
              requestAnimationFrame(animate);
            }
          };
          animate();
          counterObserver.unobserve(el);
        }
      });
    },
    { threshold: 0.3 }
  );
  counters.forEach((c) => counterObserver.observe(c));
</script>
