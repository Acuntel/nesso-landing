---
const testimonials = [
  {
    quote: "I used to go months without texting my college friends. Now I actually keep up with them, and it feels so good.",
    name: "Sarah K.",
    context: "College grad, 23",
  },
  {
    quote: "The iMessage extension is genius. I get a suggestion right when I need it, no switching apps.",
    name: "Marcus T.",
    context: "Working professional, 26",
  },
  {
    quote: "My mom noticed I've been calling more. That's all I needed to hear.",
    name: "Priya R.",
    context: "Grad student, 22",
  },
];
---

<section id="about" class="py-20 sm:py-32 px-4 sm:px-6 relative" data-bg="#0a0a14">
  <div class="max-w-4xl mx-auto relative" style="z-index: 2;">
    <!-- Headline -->
    <div class="text-center mb-12 reveal">
      <div class="hud-bracket inline-block mb-4">
        <span class="text-xs font-mono text-cyan/50 tracking-[0.3em] uppercase">Field Reports</span>
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-foreground mb-3">Real people. Real connections.</h2>
      <p class="text-foreground/40">Hear from people who stopped letting friendships fade.</p>
    </div>

    <!-- Testimonial cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-14">
      {testimonials.map((t, i) => (
        <div
          class="testimonial-card glass-card rounded-2xl p-6 flex flex-col holo-border relative overflow-hidden reveal"
          style={`transition-delay: ${i * 0.1}s;`}
        >
          {/* Scan line */}
          <div class="absolute inset-0 pointer-events-none scan-line opacity-20"></div>

          {/* Quote mark */}
          <svg class="w-8 h-8 text-cyan/20 mb-3 shrink-0 relative" viewBox="0 0 24 24" fill="currentColor">
            <path d="M11 7.5a4.5 4.5 0 0 0-4.5 4.5c0 1.5.7 2.5 1.5 3.5-.8 1-2 2.5-3 3.5 1.5.5 4 0 5.5-1.5 1-.5 2-1.5 2-3.5V9a2 2 0 0 0-1.5-1.5zm8 0a4.5 4.5 0 0 0-4.5 4.5c0 1.5.7 2.5 1.5 3.5-.8 1-2 2.5-3 3.5 1.5.5 4 0 5.5-1.5 1-.5 2-1.5 2-3.5V9a2 2 0 0 0-1.5-1.5z"/>
          </svg>
          <p class="text-sm text-foreground/60 leading-relaxed mb-4 flex-1 italic relative">
            "{t.quote}"
          </p>
          <div class="relative">
            <p class="text-sm font-semibold text-foreground">{t.name}</p>
            <p class="text-xs text-foreground/30 font-mono">{t.context}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Founder card -->
    <div class="glass-card rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row items-center gap-5 holo-border relative overflow-hidden reveal" style="transition-delay: 0.4s;">
      {/* Scan line */}
      <div class="absolute inset-0 pointer-events-none scan-line opacity-20"></div>

      <!-- Avatar -->
      <div class="w-16 h-16 rounded-full flex items-center justify-center shrink-0 relative" style="background: linear-gradient(135deg, rgba(0, 212, 255, 0.15), rgba(233, 30, 140, 0.15)); border: 1px solid rgba(0, 212, 255, 0.2);">
        <span class="text-2xl font-bold text-foreground/70">B</span>
      </div>
      <div class="text-center sm:text-left relative">
        <div class="flex items-center gap-2 mb-1 justify-center sm:justify-start">
          <p class="text-sm font-semibold text-foreground">
            Built with care by Brady Schwartz
          </p>
          <span class="text-[10px] font-mono text-cyan/50 border border-cyan/20 rounded px-1.5 py-0.5">VERIFIED</span>
        </div>
        <p class="text-sm text-foreground/40 leading-relaxed">
          "The small, consistent moments, a text, a call, a voice note, are what relationships are actually made of. I built Nesso because I kept losing touch with people I cared about, and I didn't want that to be the default."
        </p>
        <!-- Social links -->
        <div class="flex gap-4 mt-3 justify-center sm:justify-start">
          <a
            href="https://instagram.com/nesso_app"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs text-foreground/30 hover:text-cyan transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            @nesso_app
          </a>
          <a
            href="https://tiktok.com/@nesso.app"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs text-foreground/30 hover:text-cyan transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.11V9.02a6.19 6.19 0 00-.79-.05A6.27 6.27 0 003.22 15.24a6.27 6.27 0 006.27 6.27 6.27 6.27 0 006.27-6.27V9.49a8.2 8.2 0 004.83 1.56V7.62a4.84 4.84 0 01-1-.93z"/></svg>
            @nesso.app
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Testimonial cards float in with 3D rotation
  const testimonialCards = document.querySelectorAll('.testimonial-card');
  testimonialCards.forEach((card, i) => {
    gsap.from(card, {
      y: 40,
      rotateZ: (i - 1) * 3,
      opacity: 0,
      duration: 0.8,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: card,
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
    });
  });
</script>
