---
interface Props {
  size?: 'sm' | 'lg';
  class?: string;
}

const { size = 'lg', class: className = '' } = Astro.props;
const appStoreUrl = 'https://apps.apple.com/us/app/nesso-ai/id6759138532';
const height = size === 'lg' ? 'h-14 sm:h-16' : 'h-11';
---

<a
  href={appStoreUrl}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    'inline-flex items-center gap-3 bg-foreground text-background rounded-xl px-5 font-semibold hover:opacity-90 transition-opacity',
    height,
    className,
  ]}
>
  <svg xmlns="http://www.w3.org/2000/svg" width={size === 'lg' ? 24 : 18} height={size === 'lg' ? 24 : 18} viewBox="0 0 24 24" fill="currentColor">
    <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
  </svg>
  <div class="text-left">
    <div class:list={['leading-none', size === 'lg' ? 'text-[10px] sm:text-xs' : 'text-[9px]']}>Download on the</div>
    <div class:list={['leading-tight', size === 'lg' ? 'text-lg sm:text-xl' : 'text-base']}>App Store</div>
  </div>
</a>
